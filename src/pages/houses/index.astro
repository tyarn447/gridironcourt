---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const houses = (await getCollection('houses')).sort((a, b) => a.data.team.localeCompare(b.data.team));
---
<Base title="The Houses">
  <h2 class="section-head">The Thirty-Two Houses</h2>
  {houses.map((h) => (
    <article class="card">
      <h3><a href={`/houses/${h.id}/`}>House {h.data.team}</a></h3>
      <p><em>“{h.data.words}”</em> — {h.data.city} · {h.data.seat}</p>
      {!h.data.chronicled && <p class="houses-tag"><em>Not yet chronicled.</em></p>}
    </article>
  ))}
</Base>
