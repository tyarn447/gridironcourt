---
import { withBase } from '../config';
import { getEntry } from 'astro:content';
const { post } = Astro.props;
const houses = await Promise.all(post.data.houses.map((s) => getEntry('houses', s)));
const named = houses.filter(Boolean);
---
<article class="card">
  <div class="card-meta">
    <span class="chapter">{post.data.chapter}</span>
    <span>Week {post.data.week}</span>
    <span>{post.data.frame === 'war' ? 'A war' : 'A court intrigue'}</span>
    <span>{post.data.trope}</span>
  </div>
  <h3><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></h3>
  <p>{post.data.excerpt}</p>
  <p class="houses-tag">
    {named.map((h, i) => (
      <>{i > 0 && ' · '}<a href={withBase(`/houses/${h.id}/`)}>House {h.data.team}</a></>
    ))}
  </p>
  <blockquote class="pull">
    <span class="label">The line you say tomorrow</span>
    “{post.data.line}”
  </blockquote>
</article>
