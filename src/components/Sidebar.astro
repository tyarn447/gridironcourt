---
import { getCollection } from 'astro:content';
import { withBase } from '../config';
const { current } = Astro.props;
const houses = await getCollection('houses');
const grouped = ['AFC', 'NFC'].map((conf) => ({
  conf,
  divisions: ['East', 'North', 'South', 'West'].map((div) => ({
    div,
    houses: houses
      .filter((h) => h.data.conference === conf && h.data.division === div)
      .sort((a, b) => a.data.team.localeCompare(b.data.team)),
  })),
}));
const currentHouse = current ? houses.find((h) => h.id === current) : null;
---
<aside class="sidebar">
  {/* Checkbox disclosure rather than <details open>: `open` is a boolean
      attribute and can't be made responsive in CSS, which meant mobile
      readers scrolled 32 links before reaching any content. This collapses
      on mobile and is always shown on desktop, with no JS and no flash. */}
  <input type="checkbox" id="house-nav-toggle" class="nav-check" />
  <label for="house-nav-toggle" class="nav-toggle">
    <span class="nav-toggle-label">The Houses</span>
    {currentHouse && <span class="nav-toggle-current">House {currentHouse.data.team}</span>}
  </label>

  <nav class="house-nav" aria-label="The houses of the realm">
    <h2>The Houses</h2>
    <p class="sidebar-note">
      Thirty-two houses. Click one for its chronicle and every dispatch it appears in.
    </p>
    {grouped.map(({ conf, divisions }) => (
      <div class="conf-block">
        <div class="conf">{conf}</div>
        {divisions.map(({ div, houses }) => (
          <div class="div-block">
            <div class="div-label">{conf} {div}</div>
            <ul class="house-list">
              {houses.map((h) => (
                <li>
                  <a href={withBase(`/houses/${h.id}/`)} aria-current={current === h.id ? 'page' : undefined}>
                    <span class="swatch" style={`background:${h.data.ink}`} aria-hidden="true"></span>
                    <span>House {h.data.team}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </nav>
</aside>
